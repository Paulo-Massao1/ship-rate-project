rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isRestrictedModuleUser() {
      return isSignedIn()
             && (request.auth.uid == 'vvmd4t7NHgYEiRbE3aPPcyGscdq1'
                 || (request.auth.token.email != null
                     && (request.auth.token.email == 'plantao@nortepilot.com.br'
                         || request.auth.token.email == 'operacional@adjservicos.com.br'
                         || request.auth.token.email.matches('.*@cspam\\.com\\.br$'))));
    }

    function canAccessRestrictedModules() {
      return isSignedIn() && !isRestrictedModuleUser();
    }

    function isValidManeuverTugSnapshot(tug) {
      return tug is map
             && tug.keys().hasAll(['id', 'name', 'type', 'source'])
             && tug.keys().hasOnly([
               'id', 'name', 'bollardPull', 'type', 'source'
             ])
             && tug.id is string
             && tug.id.size() >= 1
             && tug.id.size() <= 120
             && tug.name is string
             && tug.name.size() >= 1
             && tug.name.size() <= 60
             && tug.type in ['azimuthal', 'conventional', 'unspecified']
             && tug.source in ['operationalParameters', 'community']
             && (!('bollardPull' in tug)
                 || (tug.bollardPull is number
                     && tug.bollardPull > 0
                     && tug.bollardPull <= 200));
    }

    function isValidManeuverShip(ship) {
      return ship is map
             && ship.keys().hasOnly([
               'id',
               'name',
               'lengthMeters',
               'beamMeters',
               'maximumDraftMeters',
               'propellerDirection',
               'propellerPitch',
               'officerNationality',
               'crewNationality'
             ])
             && (!('id' in ship)
                 || (ship.id is string && ship.id.size() <= 120))
             && (!('name' in ship)
                 || (ship.name is string && ship.name.size() <= 120))
             && (!('lengthMeters' in ship)
                 || (ship.lengthMeters is number
                     && ship.lengthMeters > 0
                     && ship.lengthMeters <= 500))
             && (!('beamMeters' in ship)
                 || (ship.beamMeters is number
                     && ship.beamMeters > 0
                     && ship.beamMeters <= 100))
             && (!('maximumDraftMeters' in ship)
                 || (ship.maximumDraftMeters is number
                     && ship.maximumDraftMeters > 0
                     && ship.maximumDraftMeters <= 100))
             && (!('propellerDirection' in ship)
                 || ship.propellerDirection in ['rightHanded', 'leftHanded'])
             && (!('propellerPitch' in ship)
                 || ship.propellerPitch in ['fixed', 'controllable'])
             && (!('officerNationality' in ship)
                 || (ship.officerNationality is string
                     && ship.officerNationality.size() <= 80))
             && (!('crewNationality' in ship)
                 || (ship.crewNationality is string
                     && ship.crewNationality.size() <= 80));
    }

    function isValidManeuverApproach(approach) {
      return approach is map
             && approach.keys().hasOnly([
               'forwardTug',
               'aftTug',
               'currentDirectionDegrees',
               'currentIntensityKnots',
               'windDirectionDegrees',
               'windIntensityKnots',
               'comments'
             ])
             && (!('forwardTug' in approach)
                 || isValidManeuverTugSnapshot(approach.forwardTug))
             && (!('aftTug' in approach)
                 || isValidManeuverTugSnapshot(approach.aftTug))
             && (!('currentDirectionDegrees' in approach)
                 || (approach.currentDirectionDegrees is int
                     && approach.currentDirectionDegrees >= 0
                     && approach.currentDirectionDegrees <= 359))
             && (!('currentIntensityKnots' in approach)
                 || (approach.currentIntensityKnots is number
                     && approach.currentIntensityKnots >= 0
                     && approach.currentIntensityKnots <= 100))
             && (!('windDirectionDegrees' in approach)
                 || (approach.windDirectionDegrees is int
                     && approach.windDirectionDegrees >= 0
                     && approach.windDirectionDegrees <= 359))
             && (!('windIntensityKnots' in approach)
                 || (approach.windIntensityKnots is number
                     && approach.windIntensityKnots >= 0
                     && approach.windIntensityKnots <= 200))
             && (!('comments' in approach)
                 || (approach.comments is string
                     && approach.comments.size() <= 2000));
    }

    function isValidManeuverMooring(mooring) {
      return mooring is map
             && mooring.keys().hasOnly([
               'forwardFirstLine', 'aftFirstLine', 'comments'
             ])
             && (!('forwardFirstLine' in mooring)
                 || mooring.forwardFirstLine in [
                   'headLine', 'breastLine', 'spring'
                 ])
             && (!('aftFirstLine' in mooring)
                 || mooring.aftFirstLine in [
                   'headLine', 'breastLine', 'spring'
                 ])
             && (!('comments' in mooring)
                 || (mooring.comments is string
                     && mooring.comments.size() <= 2000));
    }

    function isValidManeuverMediaItem(item, pilotId, reportId, section) {
      return item is map
             && item.keys().hasAll([
               'path', 'originalName', 'contentType', 'sizeBytes', 'type'
             ])
             && item.keys().hasOnly([
               'path', 'originalName', 'contentType', 'sizeBytes', 'type'
             ])
             && item.path is string
             && item.path.matches(
               '^manobras/' + pilotId + '/' + reportId + '/' + section
               + '/[A-Za-z0-9._-]+$'
             )
             && item.originalName is string
             && item.originalName.size() >= 1
             && item.originalName.size() <= 160
             && item.contentType in [
               'image/jpeg', 'image/png', 'image/webp',
               'video/mp4', 'video/quicktime'
             ]
             && item.sizeBytes is int
             && item.sizeBytes > 0
             && item.sizeBytes <= 20 * 1024 * 1024
             && item.type in ['photo', 'video']
             && ((item.type == 'photo'
                  && item.contentType.matches('^image/.*$'))
                 || (item.type == 'video'
                     && item.contentType.matches('^video/.*$')));
    }

    function isValidManeuverMediaList(items, pilotId, reportId, section) {
      return items is list
             && items.size() <= 3
             && (items.size() < 1
                 || isValidManeuverMediaItem(
                      items[0], pilotId, reportId, section
                    ))
             && (items.size() < 2
                 || isValidManeuverMediaItem(
                      items[1], pilotId, reportId, section
                    ))
             && (items.size() < 3
                 || isValidManeuverMediaItem(
                      items[2], pilotId, reportId, section
                    ));
    }

    function isValidManeuverMedia(media, pilotId, reportId) {
      return media is map
             && media.keys().hasAll(['approach', 'mooring'])
             && media.keys().hasOnly(['approach', 'mooring'])
             && isValidManeuverMediaList(
                  media.approach, pilotId, reportId, 'approach'
                )
             && isValidManeuverMediaList(
                  media.mooring, pilotId, reportId, 'mooring'
                );
    }

    function isValidManeuverReport(data, reportId) {
      return data.keys().hasAll([
               'schemaVersion',
               'pilotId',
               'portName',
               'portCode',
               'terminalId',
               'terminalName',
               'ship',
               'approach',
               'mooring',
               'createdAt',
               'updatedAt'
             ])
             && data.keys().hasOnly([
               'schemaVersion',
               'pilotId',
               'pilotName',
               'portName',
               'portCode',
               'terminalId',
               'terminalName',
               'ship',
               'approach',
               'mooring',
               'media',
               'createdAt',
               'updatedAt'
             ])
             && data.schemaVersion in [2, 3]
             && data.pilotId is string
             && (!('pilotName' in data)
                 || (data.pilotName is string && data.pilotName.size() <= 80))
             && data.portName is string
             && data.portName.size() >= 1
             && data.portName.size() <= 80
             && data.portCode in ['SAN', 'STM', 'JAR', 'JUR', 'PTR', 'ITA']
             && data.terminalId is string
             && data.terminalId.size() >= 1
             && data.terminalId.size() <= 80
             && data.terminalName is string
             && data.terminalName.size() >= 1
             && data.terminalName.size() <= 80
             && isValidManeuverShip(data.ship)
             && isValidManeuverApproach(data.approach)
             && isValidManeuverMooring(data.mooring)
             && ((data.schemaVersion == 2 && !('media' in data))
                 || (data.schemaVersion == 3
                     && isValidManeuverMedia(
                          data.media, data.pilotId, reportId
                        )));
    }

    function isReleasedManeuverTerminal(data) {
      return data.portCode == 'STM'
             && data.portName == 'Santarém'
             && data.terminalId == 'stm_cargill'
             && data.terminalName == 'Cargill';
    }

    match /usuarios/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /pilotStats/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /navios/{shipId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;

      match /avaliacoes/{ratingId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.auth.uid == request.resource.data.usuarioId;
        allow update, delete: if isSignedIn()
                              && resource.data.usuarioId == request.auth.uid;

        match /likes/{likeId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.auth.uid == likeId;
          allow delete: if isSignedIn() && request.auth.uid == likeId;
        }
      }
    }

    match /locais/{locationId} {
      allow read: if canAccessRestrictedModules();
      allow create: if canAccessRestrictedModules();
      allow update: if false;
      allow delete: if canAccessRestrictedModules()
                    && resource.data.createdBy == request.auth.uid;

      match /registros/{recordId} {
        allow read: if canAccessRestrictedModules();
        allow create: if canAccessRestrictedModules()
                      && request.auth.uid == request.resource.data.pilotId;
        allow update, delete: if canAccessRestrictedModules()
                              && resource.data.pilotId == request.auth.uid;

        match /likes/{likeId} {
          allow read: if canAccessRestrictedModules();
          allow create: if canAccessRestrictedModules()
                        && request.auth.uid == likeId;
          allow delete: if canAccessRestrictedModules()
                        && request.auth.uid == likeId;
        }
      }
    }

    // Shared tugboat catalog for maneuver reports. Official entries remain
    // bundled with the app; this collection stores immutable community entries.
    match /maneuverTugs/{tugId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll([
                      'name',
                      'normalizedName',
                      'lookupKey',
                      'portCode',
                      'type',
                      'source',
                      'createdBy',
                      'createdAt'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'name',
                      'normalizedName',
                      'lookupKey',
                      'portCode',
                      'type',
                      'source',
                      'createdBy',
                      'createdAt',
                      'bollardPull'
                    ])
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.source == 'community'
                    && request.resource.data.portCode in [
                      'SAN', 'STM', 'JAR', 'JUR', 'PTR', 'ITA'
                    ]
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.normalizedName is string
                    && request.resource.data.normalizedName.size() >= 2
                    && request.resource.data.normalizedName.size() <= 60
                    && request.resource.data.lookupKey is string
                    && request.resource.data.lookupKey.size() >= 1
                    && request.resource.data.lookupKey.size() <= 60
                    && request.resource.data.lookupKey.matches('^[a-z0-9-]+$')
                    && tugId == request.resource.data.portCode
                                + '--' + request.resource.data.lookupKey
                    && request.resource.data.type in [
                      'azimuthal', 'conventional', 'unspecified'
                    ]
                    && (!('bollardPull' in request.resource.data)
                        || (request.resource.data.bollardPull is number
                            && request.resource.data.bollardPull > 0
                            && request.resource.data.bollardPull <= 200));
      allow update, delete: if false;
    }

    match /manobras_relatos/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.pilotId == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && isReleasedManeuverTerminal(request.resource.data)
                    && isValidManeuverReport(
                         request.resource.data, reportId
                       );
      allow update: if isSignedIn()
                    && resource.data.pilotId == request.auth.uid
                    && request.resource.data.pilotId == resource.data.pilotId
                    && request.resource.data.portCode == resource.data.portCode
                    && request.resource.data.portName == resource.data.portName
                    && request.resource.data.terminalId
                       == resource.data.terminalId
                    && request.resource.data.terminalName
                       == resource.data.terminalName
                    && isReleasedManeuverTerminal(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time
                    && isValidManeuverReport(
                         request.resource.data, reportId
                       );
      allow delete: if isSignedIn()
                    && resource.data.pilotId == request.auth.uid;
    }

    match /authorized_emails/{docId} {
      allow read: if false;
      allow write: if false;
    }

    match /otp_codes/{docId} {
      allow read, write: if false;
    }

    match /sugestoes/{docId} {
      allow read: if false;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /stats/{docId} {
      allow read: if isSignedIn()
                  && (docId != 'depthRecords' || canAccessRestrictedModules());
      allow write: if false;
    }

    match /cruzamentos/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.pilotoId;
      allow update, delete: if isSignedIn()
                            && request.auth.uid == resource.data.pilotoId;
    }

    match /{path=**}/registros/{recordId} {
      allow read: if canAccessRestrictedModules();
    }
  }
}
